<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/light_grey"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_voucher_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_voucher_value"
                android:textColor="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_min_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/minimum_price_to_use"
                android:textColor="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_expire_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/start_time"
                android:textColor="@color/black" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:progress="0"
                app:indicatorColor="@color/button_color"
                app:trackColor="@color/grey" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/rb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        app:buttonTint="@color/button_color"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"/>

</LinearLayout>