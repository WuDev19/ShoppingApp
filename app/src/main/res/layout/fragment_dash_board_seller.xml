<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dashboard_surface"
    android:theme="@style/ThemeOverlay.ShoppingApp.Dashboard">

    <LinearLayout
        android:id="@+id/linear_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/border_under"
        android:backgroundTint="@color/button_color"
        android:paddingHorizontal="@dimen/dashboard_small_spacing"
        android:paddingVertical="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/img_back"
            android:layout_width="@dimen/dashboard_touch_size"
            android:layout_height="@dimen/dashboard_touch_size"
            android:src="@drawable/icon_back"
            android:contentDescription="@string/dashboard_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dashboard_small_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textSize="17sp"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/dashboard_subtitle"
                android:textSize="12sp"
                android:textColor="#E0E7FF" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/img_setting"
            android:layout_width="@dimen/dashboard_touch_size"
            android:layout_height="@dimen/dashboard_touch_size"
            android:padding="@dimen/dashboard_small_spacing"
            android:src="@drawable/icon_setting"
            android:contentDescription="@string/dashboard_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dashboard_spacing"
        android:layout_marginTop="@dimen/dashboard_small_spacing"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/icon_calendar"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/button_color"
                style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_year"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/icon_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/button_color"
                    style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dashboard_small_spacing"
                    android:text="@string/dashboard_refresh"
                    style="@style/Widget.ShoppingApp.Dashboard.Button" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/filter_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dashboard_spacing"
        android:layout_marginTop="4dp"
        android:text="@string/dashboard_invalid"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_dash_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/dashboard_spacing" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dashboard_spacing"
            android:paddingVertical="@dimen/dashboard_small_spacing">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_voucher"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/create_voucher"
                style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_product"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dashboard_small_spacing"
                android:text="@string/new_product"
                style="@style/Widget.ShoppingApp.Dashboard.Button" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
