<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_surface"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.ShoppingApp.Dashboard">

    <!-- Top App Bar -->
    <LinearLayout
        android:fitsSystemWindows="true"
        android:id="@+id/linear_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_under"
        android:backgroundTint="@color/button_color"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dashboard_small_spacing"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/img_back"
            android:layout_width="@dimen/dashboard_touch_size"
            android:layout_height="@dimen/dashboard_touch_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_back"
            android:src="@drawable/icon_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dashboard_small_spacing"
            android:layout_weight="1"
            android:text="@string/dashboard_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/img_setting"
            android:layout_width="@dimen/dashboard_touch_size"
            android:layout_height="@dimen/dashboard_touch_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_settings"
            android:padding="@dimen/dashboard_small_spacing"
            android:src="@drawable/icon_setting"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Filter Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dashboard_spacing"
        android:layout_marginTop="@dimen/dashboard_small_spacing"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_range"
                style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                app:icon="@drawable/icon_calendar"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="@color/button_color"
                app:strokeColor="@color/button_color"
                app:strokeWidth="1.5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_year"
                    style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    app:icon="@drawable/icon_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/button_color"
                    app:strokeColor="@color/button_color"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    style="@style/Widget.ShoppingApp.Dashboard.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dashboard_small_spacing"
                    android:layout_weight="1"
                    android:text="@string/dashboard_refresh"
                    android:textStyle="bold"
                    app:elevation="2dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/filter_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:accessibilityLiveRegion="polite"
        android:paddingHorizontal="@dimen/dashboard_spacing"
        android:text="@string/dashboard_invalid"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_dash_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/dashboard_spacing" />

    <!-- Bottom Actions Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dashboard_spacing"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_voucher"
                style="@style/Widget.ShoppingApp.Dashboard.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/create_voucher"
                android:textStyle="bold"
                app:strokeColor="@color/button_color"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_product"
                style="@style/Widget.ShoppingApp.Dashboard.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/dashboard_small_spacing"
                android:layout_weight="1"
                android:text="@string/new_product"
                android:textStyle="bold"
                app:elevation="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
