<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >

        <action
            android:id="@+id/action_homeFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />

        <action
            android:id="@+id/action_homeFragment_to_cartFragment"
            app:destination="@id/cartFragment" />

    </fragment>

    <fragment
        android:id="@+id/detailProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.DetailProductFragment"
        android:label="fragment_detail_product"
        tools:layout="@layout/fragment_detail_product" >
        <action
            android:id="@+id/action_detailProductFragment_self"
            app:destination="@id/detailProductFragment" />
        <action
            android:id="@+id/action_detailProductFragment_to_imageDescriptionProductFragment"
            app:destination="@id/imageDescriptionProductFragment" />
        <action
            android:id="@+id/action_detailProductFragment_to_sellerFragment"
            app:destination="@id/sellerFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" >
        <action
            android:id="@+id/action_cartFragment_to_imageDescriptionProductFragment"
            app:destination="@id/imageDescriptionProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/imageDescriptionProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.ImageDescriptionProductFragment"
        android:label="fragment_image_description_product"
        tools:layout="@layout/fragment_image_description_product" />
    <fragment
        android:id="@+id/sellerFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SellerFragment"
        android:label="fragment_seller"
        tools:layout="@layout/fragment_seller" >
        <action
            android:id="@+id/action_sellerFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />
        <action
            android:id="@+id/action_sellerFragment_to_categoryProductDetailShopFragment"
            app:destination="@id/categoryProductDetailShopFragment" />
        <action
            android:id="@+id/action_sellerFragment_to_searchProductFragment"
            app:destination="@id/searchProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/categoryProductDetailShopFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.CategoryProductDetailShopFragment"
        android:label="fragment_category_product_detail_shop"
        tools:layout="@layout/fragment_category_product_detail_shop" >
        <action
            android:id="@+id/action_categoryProductDetailShopFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SearchProductFragment"
        android:label="fragment_search_product"
        tools:layout="@layout/fragment_search_product" />

</navigation>