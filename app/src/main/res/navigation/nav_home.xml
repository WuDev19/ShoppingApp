<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >

        <action
            android:id="@+id/action_homeFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />

        <action
            android:id="@+id/action_homeFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_homeFragment_to_recentChatFragment"
            app:destination="@id/recentChatFragment" />

    </fragment>

    <fragment
        android:id="@+id/detailProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.DetailProductFragment"
        android:label="fragment_detail_product"
        tools:layout="@layout/fragment_detail_product" >
        <action
            android:id="@+id/action_detailProductFragment_self"
            app:destination="@id/detailProductFragment" />
        <action
            android:id="@+id/action_detailProductFragment_to_imageDescriptionProductFragment"
            app:destination="@id/imageDescriptionProductFragment" />
        <action
            android:id="@+id/action_detailProductFragment_to_sellerFragment"
            app:destination="@id/sellerFragment" />
        <action
            android:id="@+id/action_detailProductFragment_to_purchaseProductFragment"
            app:destination="@id/purchaseProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" >
        <action
            android:id="@+id/action_cartFragment_to_imageDescriptionProductFragment"
            app:destination="@id/imageDescriptionProductFragment" />
        <action
            android:id="@+id/action_cartFragment_to_purchaseProductFragment"
            app:destination="@id/purchaseProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/imageDescriptionProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.product.ImageDescriptionProductFragment"
        android:label="fragment_image_description_product"
        tools:layout="@layout/fragment_image_description_product" />
    <fragment
        android:id="@+id/sellerFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SellerFragment"
        android:label="fragment_seller"
        tools:layout="@layout/fragment_seller" >
        <action
            android:id="@+id/action_sellerFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />
        <action
            android:id="@+id/action_sellerFragment_to_categoryProductDetailShopFragment"
            app:destination="@id/categoryProductDetailShopFragment" />
        <action
            android:id="@+id/action_sellerFragment_to_searchProductFragment"
            app:destination="@id/searchProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/categoryProductDetailShopFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.CategoryProductDetailShopFragment"
        android:label="fragment_category_product_detail_shop"
        tools:layout="@layout/fragment_category_product_detail_shop" >
        <action
            android:id="@+id/action_categoryProductDetailShopFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SearchProductFragment"
        android:label="fragment_search_product"
        tools:layout="@layout/fragment_search_product" >
        <action
            android:id="@+id/action_searchProductFragment_to_detailProductFragment"
            app:destination="@id/detailProductFragment" />
    </fragment>
    <fragment
        android:id="@+id/recentChatFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.RecentChatFragment"
        android:label="fragment_recent_chat"
        tools:layout="@layout/fragment_recent_chat" >
        <action
            android:id="@+id/action_recentChatFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat" />
    <fragment
        android:id="@+id/purchaseProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.PurchaseProductFragment"
        android:label="fragment_purchase_product"
        tools:layout="@layout/fragment_purchase_product" >
        <action
            android:id="@+id/action_purchaseProductFragment_to_addressFragment2"
            app:destination="@id/addressFragment2" />
        <action
            android:id="@+id/action_purchaseProductFragment_to_afterPurchaseFragment"
            app:destination="@id/afterPurchaseFragment" />
    </fragment>
    <fragment
        android:id="@+id/addressFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address" >
        <action
            android:id="@+id/action_addressFragment2_to_editAddressFragment2"
            app:destination="@id/editAddressFragment2" />
    </fragment>
    <fragment
        android:id="@+id/editAddressFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.EditAddressFragment"
        android:label="fragment_edit_address"
        tools:layout="@layout/fragment_edit_address" >
        <action
            android:id="@+id/action_editAddressFragment2_to_mapFragment3"
            app:destination="@id/mapFragment3" />
    </fragment>
    <fragment
        android:id="@+id/mapFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.MapFragment"
        android:label="fragment_map"
        tools:layout="@layout/fragment_map" />
    <fragment
        android:id="@+id/afterPurchaseFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.AfterPurchaseFragment"
        android:label="fragment_after_purchase"
        tools:layout="@layout/fragment_after_purchase" >
        <action
            android:id="@+id/action_afterPurchaseFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.OrderDetailFragment"
        android:label="fragment_order_detail"
        tools:layout="@layout/fragment_order_detail" />

</navigation>