<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_profile"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_cartFragment3"
            app:destination="@id/cartFragment3" />
        <action
            android:id="@+id/action_profileFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <action
            android:id="@+id/action_profileFragment_to_registerSellerFragment"
            app:destination="@id/registerSellerFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_editProfileFragment_to_changeNameFragment"
            app:destination="@id/changeNameFragment" />
        <action
            android:id="@+id/action_editProfileFragment_to_changeEmailAndPhoneFragment"
            app:destination="@id/changeEmailAndPhoneFragment" />
    </fragment>
    <fragment
        android:id="@+id/changeNameFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.ChangeNameAndGenderFragment"
        android:label="fragment_change_name"
        tools:layout="@layout/fragment_change_name_gender" />
    <fragment
        android:id="@+id/cartFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" />
    <fragment
        android:id="@+id/changeEmailAndPhoneFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.ChangeEmailAndPhoneFragment"
        android:label="fragment_change_email_and_phone"
        tools:layout="@layout/fragment_change_email_and_phone" />
    <fragment
        android:id="@+id/addressFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address">
        <action
            android:id="@+id/action_addressFragment_to_editAddressFragment"
            app:destination="@id/editAddressFragment" />
    </fragment>
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.MapFragment"
        android:label="fragment_map"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_mapFragment_to_editAddressFragment3"
            app:destination="@id/editAddressFragment" />
    </fragment>

    <fragment
        android:id="@+id/editAddressFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.EditAddressFragment"
        android:label="fragment_edit_address"
        tools:layout="@layout/fragment_edit_address">
        <action
            android:id="@+id/action_editAddressFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerSellerFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.RegisterSellerFragment"
        android:label="fragment_register_seller"
        tools:layout="@layout/fragment_register_seller">
        <action
            android:id="@+id/action_registerSellerFragment_to_mapFragment2"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_registerSellerFragment_to_sendOtpFragment"
            app:destination="@id/sendOtpFragment" />
    </fragment>
    <fragment
        android:id="@+id/sendOtpFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SendOtpFragment"
        android:label="fragment_send_otp"
        tools:layout="@layout/fragment_send_otp">

        <argument
            android:name="uri_anh"
            app:argType="android.net.Uri"
            app:nullable="true" />

        <argument
            android:name="shop_name"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="shop_address"
            app:argType="string"
            app:nullable="false" />

    </fragment>

</navigation>