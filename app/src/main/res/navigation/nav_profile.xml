<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_profile"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_cartFragment3"
            app:destination="@id/cartFragment3" />
        <action
            android:id="@+id/action_profileFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <action
            android:id="@+id/action_profileFragment_to_registerSellerFragment"
            app:destination="@id/registerSellerFragment" />
        <action
            android:id="@+id/action_profileFragment_to_dashBoardSellerFragment"
            app:destination="@id/dashBoardSellerFragment" />
        <action
            android:id="@+id/action_profileFragment_to_myOrderFragment"
            app:destination="@id/myOrderFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_editProfileFragment_to_changeNameFragment"
            app:destination="@id/changeNameFragment" />
        <action
            android:id="@+id/action_editProfileFragment_to_changeEmailAndPhoneFragment"
            app:destination="@id/changeEmailAndPhoneFragment" />
    </fragment>
    <fragment
        android:id="@+id/changeNameFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.ChangeNameAndGenderFragment"
        android:label="fragment_change_name"
        tools:layout="@layout/fragment_change_name_gender" />
    <fragment
        android:id="@+id/cartFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" />
    <fragment
        android:id="@+id/changeEmailAndPhoneFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.ChangeEmailAndPhoneFragment"
        android:label="fragment_change_email_and_phone"
        tools:layout="@layout/fragment_change_email_and_phone" />
    <fragment
        android:id="@+id/addressFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address">
        <action
            android:id="@+id/action_addressFragment_to_editAddressFragment"
            app:destination="@id/editAddressFragment" />
    </fragment>
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.MapFragment"
        android:label="fragment_map"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_mapFragment_to_editAddressFragment3"
            app:destination="@id/editAddressFragment" />
    </fragment>

    <fragment
        android:id="@+id/editAddressFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.EditAddressFragment"
        android:label="fragment_edit_address"
        tools:layout="@layout/fragment_edit_address">
        <action
            android:id="@+id/action_editAddressFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerSellerFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.RegisterSellerFragment"
        android:label="fragment_register_seller"
        tools:layout="@layout/fragment_register_seller">
        <action
            android:id="@+id/action_registerSellerFragment_to_mapFragment2"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_registerSellerFragment_to_sendOtpFragment"
            app:destination="@id/sendOtpFragment" />
    </fragment>

    <fragment
        android:id="@+id/sendOtpFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SendOtpFragment"
        android:label="fragment_send_otp"
        tools:layout="@layout/fragment_send_otp">

        <argument
            android:name="uri_anh"
            app:argType="android.net.Uri"
            app:nullable="true" />

        <argument
            android:name="shop_name"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="shop_address"
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="province_id"
            app:argType="integer" />

        <argument
            android:name="district_id"
            app:argType="integer" />

        <argument
            android:name="ward_code"
            app:argType="string"
            app:nullable="false" />
        <action
            android:id="@+id/action_sendOtpFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

    </fragment>

    <fragment
        android:id="@+id/dashBoardSellerFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.DashBoardSellerFragment"
        android:label="fragment_dash_board_seller"
        tools:layout="@layout/fragment_dash_board_seller">

        <argument
            android:name="userId"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false" />

        <action
            android:id="@+id/action_dashBoardSellerFragment_to_postProductFragment"
            app:destination="@id/postProductFragment" />
        <action
            android:id="@+id/action_dashBoardSellerFragment_to_sellerSettingFragment"
            app:destination="@id/sellerSettingFragment" />
        <action
            android:id="@+id/action_dashBoardSellerFragment_to_createVoucherFragment"
            app:destination="@id/createVoucherFragment" />

    </fragment>

    <fragment
        android:id="@+id/postProductFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.PostProductFragment"
        android:label="fragment_post_product"
        tools:layout="@layout/fragment_post_product">
        <action
            android:id="@+id/action_postProductFragment_to_postProductDetailFragment"
            app:destination="@id/postProductDetailFragment" />
        <action
            android:id="@+id/action_postProductFragment_to_imageDescriptionProductFragment3"
            app:destination="@id/imageDescriptionProductFragment3" />
    </fragment>
    <fragment
        android:id="@+id/postProductDetailFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.PostProductDetailFragment"
        android:label="fragment_post_product_detail"
        tools:layout="@layout/fragment_post_product_detail">

        <argument
            android:name="description"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false" />

        <argument
            android:name="generalPrice"
            android:defaultValue="-1"
            app:argType="integer"
            app:nullable="false" />

        <argument
            android:name="discount"
            android:defaultValue="-1"
            app:argType="integer" />

        <argument
            android:name="introduction"
            app:argType="string"
            app:nullable="true" />

        <argument
            android:name="uriList"
            app:argType="string[]"
            app:nullable="false" />

        <argument
            android:name="choseCategory"
            app:argType="integer[]"
            app:nullable="false"/>

    </fragment>
    <fragment
        android:id="@+id/imageDescriptionProductFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.product.ImageDescriptionProductFragment"
        android:label="fragment_image_description_product"
        tools:layout="@layout/fragment_image_description_product" />
    <fragment
        android:id="@+id/sellerSettingFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SellerSettingFragment"
        android:label="fragment_seller_setting"
        tools:layout="@layout/fragment_seller_setting" />
    <fragment
        android:id="@+id/createVoucherFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.CreateVoucherFragment"
        android:label="fragment_create_voucher"
        tools:layout="@layout/fragment_create_voucher" />
    <fragment
        android:id="@+id/myOrderFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.user.MyOrderFragment"
        android:label="fragment_my_order"
        tools:layout="@layout/fragment_my_order">
        <action
            android:id="@+id/action_myOrderFragment_to_orderDetailFragment3"
            app:destination="@id/orderDetailFragment3" />
        <action
            android:id="@+id/action_myOrderFragment_to_imageDescriptionProductFragment3"
            app:destination="@id/imageDescriptionProductFragment3" />
    </fragment>
    <fragment
        android:id="@+id/orderDetailFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.user.OrderDetailFragment"
        android:label="fragment_order_detail"
        tools:layout="@layout/fragment_order_detail" />

</navigation>