<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_profile"
    app:startDestination="@id/profileFragment">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_cartFragment3"
            app:destination="@id/cartFragment3" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" >
        <action
            android:id="@+id/action_editProfileFragment_to_changeNameFragment"
            app:destination="@id/changeNameFragment" />
    </fragment>
    <fragment
        android:id="@+id/changeNameFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.edit_profile.ChangeNameAndGenderFragment"
        android:label="fragment_change_name"
        tools:layout="@layout/fragment_change_name_gender" />
    <fragment
        android:id="@+id/cartFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" />
</navigation>