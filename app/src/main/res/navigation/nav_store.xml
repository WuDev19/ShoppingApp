<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_store"
    app:startDestination="@id/storeFragment">

    <fragment
        android:id="@+id/storeFragment"
        android:name="com.example.shoppingapp.ui.view.fragment.bottom_nav.StoreFragment"
        android:label="fragment_store"
        tools:layout="@layout/fragment_store" >
        <action
            android:id="@+id/action_storeFragment_to_detailProductFragment2"
            app:destination="@id/detailProductFragment2" />
        <action
            android:id="@+id/action_storeFragment_to_cartFragment22"
            app:destination="@id/cartFragment2" />
        <action
            android:id="@+id/action_storeFragment_to_sellerFragment2"
            app:destination="@id/sellerFragment2" />
    </fragment>
    <fragment
        android:id="@+id/detailProductFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.product.DetailProductFragment"
        android:label="fragment_detail_product"
        tools:layout="@layout/fragment_detail_product" >
        <action
            android:id="@+id/action_detailProductFragment2_self"
            app:destination="@id/detailProductFragment2" />
        <action
            android:id="@+id/action_detailProductFragment2_to_imageDescriptionProductFragment2"
            app:destination="@id/imageDescriptionProductFragment2" />
        <action
            android:id="@+id/action_detailProductFragment2_to_sellerFragment2"
            app:destination="@id/sellerFragment2" />
        <action
            android:id="@+id/action_detailProductFragment2_to_purchaseProductFragment2"
            app:destination="@id/purchaseProductFragment2" />
    </fragment>
    <fragment
        android:id="@+id/cartFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.product.CartFragment"
        android:label="fragment_cart"
        tools:layout="@layout/fragment_cart" >
        <action
            android:id="@+id/action_cartFragment2_to_purchaseProductFragment2"
            app:destination="@id/purchaseProductFragment2" />
    </fragment>
    <fragment
        android:id="@+id/sellerFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SellerFragment"
        android:label="fragment_seller"
        tools:layout="@layout/fragment_seller" >
        <action
            android:id="@+id/action_sellerFragment2_to_detailProductFragment2"
            app:destination="@id/detailProductFragment2" />
        <action
            android:id="@+id/action_sellerFragment2_to_searchProductFragment2"
            app:destination="@id/searchProductFragment2" />
        <action
            android:id="@+id/action_sellerFragment2_to_categoryProductDetailShopFragment2"
            app:destination="@id/categoryProductDetailShopFragment2" />
    </fragment>
    <fragment
        android:id="@+id/searchProductFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.SearchProductFragment"
        android:label="fragment_search_product"
        tools:layout="@layout/fragment_search_product" >
        <action
            android:id="@+id/action_searchProductFragment2_to_detailProductFragment2"
            app:destination="@id/detailProductFragment2" />
    </fragment>
    <fragment
        android:id="@+id/categoryProductDetailShopFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.seller.CategoryProductDetailShopFragment"
        android:label="fragment_category_product_detail_shop"
        tools:layout="@layout/fragment_category_product_detail_shop" >
        <action
            android:id="@+id/action_categoryProductDetailShopFragment2_to_detailProductFragment2"
            app:destination="@id/detailProductFragment2" />
    </fragment>
    <fragment
        android:id="@+id/imageDescriptionProductFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.product.ImageDescriptionProductFragment"
        android:label="fragment_image_description_product"
        tools:layout="@layout/fragment_image_description_product" />
    <fragment
        android:id="@+id/purchaseProductFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.user.PurchaseProductFragment"
        android:label="fragment_purchase_product"
        tools:layout="@layout/fragment_purchase_product" >
        <action
            android:id="@+id/action_purchaseProductFragment2_to_addressFragment3"
            app:destination="@id/addressFragment3" />
    </fragment>
    <fragment
        android:id="@+id/addressFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.AddressFragment"
        android:label="fragment_address"
        tools:layout="@layout/fragment_address" >
        <action
            android:id="@+id/action_addressFragment3_to_editAddressFragment3"
            app:destination="@id/editAddressFragment3" />
    </fragment>
    <fragment
        android:id="@+id/editAddressFragment3"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.EditAddressFragment"
        android:label="fragment_edit_address"
        tools:layout="@layout/fragment_edit_address" >
        <action
            android:id="@+id/action_editAddressFragment3_to_mapFragment2"
            app:destination="@id/mapFragment2" />
    </fragment>
    <fragment
        android:id="@+id/mapFragment2"
        android:name="com.example.shoppingapp.ui.view.fragment.user.edit_profile.MapFragment"
        android:label="fragment_map"
        tools:layout="@layout/fragment_map" />

</navigation>